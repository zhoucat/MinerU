# Environment variables for mineru_gradio_service

# --- For Gradio Application (gradio_app service) ---
# This service calls the mineru_local_api service.

# It uses USE_LOCAL_API and LOCAL_MINERU_API_BASE to connect to the local API.
# These are typically set in the docker-compose.yml for the gradio_app service.
# If the local API service itself requires an API key for its internal operations
# (even if it's a dummy one for local mode), set it here if not set in docker-compose.
# MINERU_API_KEY_GRADIO_CLIENT="YOUR_API_KEY_IF_NEEDED_BY_LOCAL_API_SERVICE"


# --- For Local MinerU API Service (mineru_local_api service) ---

# If the local MinerU engine (models, etc.) still requires an API key for initialization or operation,
# provide it here. For a fully offline local setup, this might be a dummy key or not needed
# if the underlying engine is configured for keyless local operation.
# The src/mineru/api.py and src/mineru/server.py currently check for MINERU_API_KEY.
# So, at least a dummy value is likely needed.
MINERU_API_KEY="LOCAL_DEV_ONLY_DUMMY_KEY"

# The following are typically used if the API service needs to call *another* MinerU API (not common for this setup)
# MINERU_API_BASE="https_mineru.net"

# Directory where the local_api service itself might store its outputs or cache
# This is set to /opt/api_service/api_outputs in docker-compose.yml by default for the container.
# OUTPUT_DIR_API_SERVICE="/opt/api_service/api_outputs"

# Log level for the MinerU library components (DEBUG, INFO, WARNING, ERROR)
# MINERU_LOG_LEVEL="INFO"
# MINERU_DEBUG="false" # Set to "true" for more verbose debug logging from mineru library
